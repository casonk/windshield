# Pinned Playwright server for windshield consumers.
# Build through scripts/playwright_container.sh so PLAYWRIGHT_VERSION always
# matches the Python client installed in this repo's environment.
ARG PLAYWRIGHT_VERSION=1.58.0
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_VERSION}-noble
ARG PLAYWRIGHT_VERSION=1.58.0
ENV PLAYWRIGHT_VERSION=${PLAYWRIGHT_VERSION}
# Install the server package at build time so the container starts offline and
# always runs the exact version it was built for.
RUN npm install -g "playwright@${PLAYWRIGHT_VERSION}" && npm cache clean --force
USER pwuser
WORKDIR /home/pwuser
EXPOSE 3000
# The server is unauthenticated: publish it on loopback only (the helper script does).
CMD ["sh", "-c", "exec playwright run-server --port 3000 --host 0.0.0.0"]
