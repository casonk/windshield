# Pinned Playwright servers for windshield consumers: one or more versions in one container,
# routed by URL path (/1.58, /1.64) from a single port. Build through
# scripts/playwright_container.sh, which fills in the build args below.
#
# Node is pinned explicitly (NODE_MAJOR) and copied over the base image's own, so a base-image
# change can never silently move it. Older Playwright releases hang extracting browsers under
# Node 26 (observed with 1.58.2 on the v1.65.1 image), hence the pin and the rotation job's
# verification before any new combination is promoted.
ARG NODE_MAJOR=24
ARG PLAYWRIGHT_BASE=1.58.0
FROM docker.io/library/node:${NODE_MAJOR}-bookworm-slim AS node

# The OLDEST served version is the base image (system libraries); newer Playwright versions
# install and launch fine on an older base.
FROM mcr.microsoft.com/playwright:v${PLAYWRIGHT_BASE}-noble
ARG NODE_MAJOR
COPY --from=node /usr/local/bin/node /usr/local/bin/node
RUN test "$(/usr/local/bin/node -p 'process.versions.node.split(".")[0]')" = "${NODE_MAJOR}" \
 && test "$(command -v node)" = /usr/local/bin/node
# Space-separated exact versions, each with its own browsers directory (/opt/pw/browsers/<v>).
ARG PLAYWRIGHT_VERSIONS="1.58.0"
ENV PLAYWRIGHT_VERSIONS=${PLAYWRIGHT_VERSIONS}
USER root
RUN set -eu; \
    for v in ${PLAYWRIGHT_VERSIONS}; do \
      mkdir -p "/opt/pw/$v" "/opt/pw/browsers/$v"; \
      npm install --prefix "/opt/pw/$v" --no-audit --no-fund "playwright@$v"; \
      ok=0; \
      for try in 1 2 3; do \
        if PLAYWRIGHT_BROWSERS_PATH="/opt/pw/browsers/$v" DEBUG=pw:install timeout 300 "/opt/pw/$v/node_modules/.bin/playwright" install chromium; then ok=1; break; fi; \
        echo "playwright $v: browser install attempt $try failed or timed out" >&2; \
      done; \
      [ "$ok" = 1 ] || { echo "playwright $v: browser install failed" >&2; exit 1; }; \
    done; \
    npm cache clean --force
COPY serve.js /opt/pw/serve.js
USER pwuser
WORKDIR /home/pwuser
EXPOSE 3000
# The servers are unauthenticated: publish on loopback only (the helper script does), or use its
# `host` network mode, which binds 127.0.0.1.
ENV PLAYWRIGHT_HOST=0.0.0.0 PLAYWRIGHT_PORT=3000
CMD ["node", "/opt/pw/serve.js"]
